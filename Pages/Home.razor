@page "/"

<PageTitle>Dr. Vinod | GeroCare</PageTitle>

<div class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="badge bg-light text-primary mb-3">
                    Senior Citizen Wellness & Healthy Ageing
                </span>

                <h1 class="display-4 fw-bold mb-3">
                    Compassionate Care for Senior Citizens
                </h1>

                <p class="lead mb-4">
                    Helping older adults maintain independence,
                    wellbeing, and dignity through personalized
                    geriatric care and healthy ageing guidance.
                </p>

                <a href="/contact" class="btn btn-primary btn-lg me-2">
                    Book Consultation
                </a>

                <a href="/about" class="btn btn-outline-primary btn-lg">
                    Learn More
                </a>

            </div>

            <div class="col-lg-6 text-center">

                <img src="dr-vinod.PNG"
                     class="img-fluid hero-image"
                     alt="Dr Vinod" />

            </div>

        </div>

    </div>

</div>

<div class="container my-5">

    <div class="row text-center">

        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">

                    <div class="stat-number">
                        20+
                    </div>

                    <div class="stat-text">
                        Years Supporting Seniors
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4 mt-3 mt-md-0">
            <div class="card stat-card">
                <div class="card-body">

                    <div class="stat-number">
                        1000+
                    </div>

                    <div class="stat-text">
                        Families Assisted
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4 mt-3 mt-md-0">
            <div class="card stat-card">
                <div class="card-body">

                    <div class="stat-number">
                        100%
                    </div>

                    <div class="stat-text">
                        Patient-Centered Care
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>

<div class="container my-5">

    <div class="text-center mb-5">

        <h2>Services</h2>

        <p class="text-muted">
            Specialized care focused on healthy ageing and quality of life.
        </p>

    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h4>Healthy Ageing</h4>

                    <p>
                        Guidance and planning to help seniors
                        enjoy active and independent lives.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h4>Chronic Disease Support</h4>

                    <p>
                        Personalized support for long-term
                        health conditions and treatment plans.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h4>Family Caregiver Guidance</h4>

                    <p>
                        Practical advice and support for
                        families caring for elderly loved ones.
                    </p>

                </div>
            </div>
        </div>

    </div>

</div>

<div class="container my-5">

    <div class="card shadow-sm">

        <div class="card-body text-center p-5">

            <h2>
                Supporting Healthy Ageing with Dignity and Independence
            </h2>

            <p class="lead mt-3">
                Every senior deserves compassionate care,
                respect, and the opportunity to live life fully.
            </p>

            <a href="/contact"
               class="btn btn-primary btn-lg">
                Contact Dr. Vinod
            </a>

        </div>

    </div>

</div>