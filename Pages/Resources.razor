@page "/resources"

<PageTitle>Senior Resources</PageTitle>

<div class="container my-5">

    <div class="text-center mb-5">

        <h1>Senior Resources</h1>

        <p class="lead">
            Helpful information, public services and guidance
            for seniors and their families.
        </p>

    </div>

    <div class="card mb-4">
        <div class="card-body">

            <h3>Healthcare Information</h3>

            <ul>
                <li>
                    <a href="https://www.helsenorge.no"
                       target="_blank">
                        Helsenorge
                    </a>

                    - Official Norwegian health information.
                </li>

                <li>
                    <a href="https://www.fhi.no"
                       target="_blank">
                        Norwegian Institute of Public Health
                    </a>
                </li>

                <li>
                    <a href="https://www.helsedirektoratet.no"
                       target="_blank">
                        Norwegian Directorate of Health
                    </a>
                </li>
            </ul>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">

            <h3>Healthy Ageing</h3>

            <ul>
                <li>Daily physical activity recommendations</li>
                <li>Fall prevention guidance</li>
                <li>Senior nutrition resources</li>
                <li>Memory and cognitive health information</li>
            </ul>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">

            <h3>Family Caregiver Support</h3>

            <ul>
                <li>Support for ageing parents</li>
                <li>Dementia information</li>
                <li>Long-term care planning</li>
                <li>Caregiver wellbeing resources</li>
            </ul>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">

            <h3>Emergency Contacts</h3>

            <ul>
                <li>Emergency: 113</li>
                <li>Medical Helpline: 116117</li>
                <li>Emergency Services: 112</li>
            </ul>

        </div>
    </div>

</div>