@page "/about"

<PageTitle>About Dr. Vinod</PageTitle>

<div class="container mt-4">

    <div class="row align-items-center">

        <div class="col-md-4 text-center">
            <img src="dr-vinod.png"
                 alt="Dr Vinod"
                 class="img-fluid rounded shadow"
                 style="max-height:400px;" />
        </div>

        <div class="col-md-8">

            <h1>Dr. Vinod</h1>

            <h4 class="text-primary">
                Gerontologist & Senior Citizen Wellness Advisor
            </h4>

            <p class="mt-4">
                Dr. Vinod is dedicated to improving the health,
                wellbeing, and quality of life of older adults.
                With a passion for healthy ageing and elder care,
                he works closely with senior citizens and their
                families to provide guidance, support, and
                personalized healthcare solutions.
            </p>

            <p>
                His focus areas include preventive healthcare,
                age-related health management, lifestyle counseling,
                chronic disease support, and promoting independent
                living among senior citizens.
            </p>

            <p>
                Through compassionate care and evidence-based
                practices, Dr. Vinod aims to help older adults
                lead active, dignified, and fulfilling lives.
            </p>

        </div>

    </div>

    <hr class="my-5" />

    <div class="row text-center">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="text-primary">20+</h2>
                    <p>Years Supporting Seniors</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mt-3 mt-md-0">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="text-primary">1000+</h2>
                    <p>Families Assisted</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mt-3 mt-md-0">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="text-primary">100%</h2>
                    <p>Patient-Centered Care</p>
                </div>
            </div>
        </div>

    </div>

    <hr class="my-5" />

    <div class="card shadow-sm">
        <div class="card-body">
        </div>
    </div>
</div>

       