@page "/services"

<PageTitle>Services | GeroCare</PageTitle>

<div class="container my-5">

    <div class="text-center mb-5">

        <h1>Services</h1>

        <p class="lead">
            Personalized support for healthy ageing,
            senior wellness, and family care.
        </p>

    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card h-100 service-card">

                <div class="card-body">

                    <h4>Initial Consultation</h4>

                    <p class="text-muted">
                        A comprehensive assessment covering
                        health, lifestyle, medications,
                        and wellbeing.
                    </p>

                    <h5 class="service-price">
                        750 NOK
                    </h5>

                    <button class="btn btn-primary w-100">
                        Book Consultation
                    </button>

                </div>

            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 service-card">

                <div class="card-body">

                    <h4>Senior Wellness Plan</h4>

                    <p class="text-muted">
                        Personalized recommendations focusing
                        on prevention, nutrition, mobility,
                        and quality of life.
                    </p>

                    <h5 class="service-price">
                        1,250 NOK
                    </h5>

                    <button class="btn btn-primary w-100">
                        Book Wellness Plan
                    </button>

                </div>

            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 service-card">

                <div class="card-body">

                    <h4>Family Care Consultation</h4>

                    <p class="text-muted">
                        Guidance and support for families
                        caring for elderly loved ones.
                    </p>

                    <h5 class="service-price">
                        950 NOK
                    </h5>

                    <button class="btn btn-primary w-100">
                        Schedule Session
                    </button>

                </div>

            </div>
        </div>

    </div>

    <div class="card mt-5 payment-card">

        <div class="card-body p-4">

            <h3>Accepted Payment Methods</h3>

            <p class="text-muted">
                Secure and convenient payment options.
            </p>

            <div class="payment-methods">

                <span class="payment-badge">
                    Vipps
                </span>

                <span class="payment-badge">
                    Visa
                </span>

                <span class="payment-badge">
                    Mastercard
                </span>

                <span class="payment-badge">
                    Apple Pay
                </span>

            </div>

        </div>

    </div>

</div>