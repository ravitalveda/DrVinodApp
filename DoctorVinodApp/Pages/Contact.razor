@page "/contact"

<PageTitle>Contact Us</PageTitle>

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1>Contact Us</h1>
        <p class="lead">
            Helping senior citizens live healthier, happier, and more independent lives.
        </p>
    </div>

    <div class="row">

        <!-- Contact Information -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h3>Get in Touch</h3>
                    <hr />

                    <p>
                        We are here to support senior citizens and their families.
                        Reach out to us for guidance, consultations, and assistance.
                    </p>

                    <p>
                        📞 <strong>Phone:</strong><br />
                        +47 41181264
                    </p>

                    <p>
                        ✉️ <strong>Email:</strong><br />
                        contact@gerocare.com
                    </p>

                    <p>
                        📍 <strong>Address:</strong><br />
                        Oslo, 0187, Norway
                    </p>

                    <p>
                        🕒 <strong>Working Hours:</strong><br />
                        Monday - Saturday<br />
                        9:00 AM - 5:00 PM
                    </p>

                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h3>Send a Message</h3>
                    <hr />

                    <EditForm Model="contactForm" OnValidSubmit="SubmitForm">

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <InputText class="form-control"
                                       @bind-Value="contactForm.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control"
                                       @bind-Value="contactForm.Email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <InputText class="form-control"
                                       @bind-Value="contactForm.Phone" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <InputTextArea class="form-control"
                                           rows="5"
                                           @bind-Value="contactForm.Message" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Send Message
                        </button>

                    </EditForm>

                    @if (submitted)
                    {
                        <div class="alert alert-success mt-3">
                            Thank you for contacting us. We will get back to you shortly.
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

</div>

@code {

    private bool submitted;

    private ContactForm contactForm = new();

    private void SubmitForm()
    {
        submitted = true;
    }

    public class ContactForm
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}