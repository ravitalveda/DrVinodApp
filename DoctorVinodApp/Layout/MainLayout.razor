@inherits LayoutComponentBase

<div class="app-shell">

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex flex-column" href="/">
                    <span class="brand-title">
                        Dr. Vinod GeroCare
                    </span>
                    <small class="brand-subtitle">
                        Healthy Ageing • Senior Wellness
                    </small>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                                Home
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/about">
                                About Dr. Vinod
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/services">
                                Services
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/resources">
                                Senior Resources
                            </NavLink>
                        </li>

                        <li class="nav-item">
                            <NavLink class="nav-link" href="/contact">
                                Contact
                            </NavLink>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <main>

        <article>
            @Body
        </article>

    </main>

    <footer class="footer">

        <div class="container">

            <p>
                © @DateTime.Now.Year GeroCare |
                Supporting Healthy Ageing with Dignity
            </p>

        </div>

    </footer>

</div>